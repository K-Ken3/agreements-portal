# PostgreSQL connection used by Prisma at runtime.
# Supabase: use the pooled connection URL (transaction pooler, port 6543) with pgbouncer=true.
DATABASE_URL="postgresql://agreements:agreements@localhost:5432/agreements?schema=public"

# Direct connection used only for migrations.
# Supabase: use the session pooler (port 5432) or the direct database host.
DIRECT_URL="postgresql://agreements:agreements@localhost:5432/agreements?schema=public"

# Set to a long, random value in production. Used for authenticated sessions.
SESSION_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Public base URL used when generating links.
APP_URL="http://localhost:3000"

# Set NODE_ENV=production behind HTTPS; session cookies are Secure in production.
